#define MyAppName "@CMAKE_PROJECT_NAME@"
#define MyAppVersion "@CMAKE_PROJECT_VERSION@"
#define MyAppPublisher "@PLUGIN_AUTHOR@"
#define MyAppURL "@PLUGIN_WEBSITE@"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{@UUID_APP@}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={commonappdata}\obs-studio\plugins\{#MyAppName}
; Older versions were installed into the OBS install directory, don't reuse that directory on updates
UsePreviousAppDir=no
DefaultGroupName={#MyAppName}
OutputBaseFilename={#MyAppName}-{#MyAppVersion}-windows-x64-Installer
Compression=lzma
SolidCompression=yes
DirExistsWarning=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[InstallDelete]
; Remove files of older versions from the legacy plugin locations, OBS Studio 34 won't load plugins from there
Type: files; Name: "{code:GetObsDir}\obs-plugins\64bit\{#MyAppName}.dll"
Type: files; Name: "{code:GetObsDir}\obs-plugins\64bit\{#MyAppName}.pdb"
Type: filesandordirs; Name: "{code:GetObsDir}\data\obs-plugins\{#MyAppName}"
Type: filesandordirs; Name: "{code:GetObsDir}\io_client"
Type: filesandordirs; Name: "{app}\bin"

[Files]
Source: "..\release\Package\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\LICENSE"; Flags: dontcopy
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{group}\{cm:ProgramOnTheWeb,{#MyAppName}}"; Filename: "{#MyAppURL}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"

[Code]
// credit where it's due :
// following function come from https://github.com/Xaymar/obs-studio_amf-encoder-plugin/blob/master/%23Resources/Installer.in.iss#L45
function GetObsDir(Value: string): string;
var
  InstallPath: string;
begin
  // initialize default path, which will be returned when the following registry
  // key queries fail due to missing keys or for some different reason
  Result := ExpandConstant('{autopf}\obs-studio');
  // query the first registry value; if this succeeds, return the obtained value
  if RegQueryStringValue(HKLM32, 'SOFTWARE\OBS Studio', '', InstallPath) then
    Result := InstallPath
end;

var
  RemovalPage: TOutputMsgMemoWizardPage;

procedure InitializeWizard();
var
  GPLText: AnsiString;
  Page: TOutputMsgMemoWizardPage;
begin
  ExtractTemporaryFile('LICENSE');
  LoadStringFromFile(ExpandConstant('{tmp}\LICENSE'), GPLText);
  Page := CreateOutputMsgMemoPage(wpWelcome,
    'License Information', 'Please review the license terms before installing {#MyAppName}',
    'Press Page Down to see the rest of the agreement. Once you are aware of your rights, click Next to continue.',
    String(GPLText)
  );

  // Users have stored their own files (e.g. presets) in these folders before, so warn about the removal.
  // The paths depend on the selected install directory, the text is filled in by CurPageChanged.
  RemovalPage := CreateOutputMsgMemoPage(wpSelectDir,
    'Warning: Old Data Will Be Removed', 'Please read this before installing {#MyAppName}',
    'The installer deletes the following folders from previous installations. ' +
    'ALL files inside them are removed, including files you added yourself (e.g. presets). ' +
    'Back up anything you want to keep before clicking Next.',
    ''
  );
end;

procedure CurPageChanged(CurPageID: Integer);
var
  ObsDir: string;
begin
  if CurPageID = RemovalPage.ID then
  begin
    ObsDir := GetObsDir('');
    RemovalPage.RichEditViewer.Text :=
      AddBackslash(WizardDirValue) + 'bin' + #13#10 +
      ObsDir + '\data\obs-plugins\{#MyAppName}' + #13#10 +
      ObsDir + '\io_client' + #13#10 + #13#10 +
      'The following legacy plugin files are also removed:' + #13#10 +
      ObsDir + '\obs-plugins\64bit\{#MyAppName}.dll' + #13#10 +
      ObsDir + '\obs-plugins\64bit\{#MyAppName}.pdb';
  end;
end;
